      "keyTerms": [
        {
          "anchor": "mse435-u04-c04-custom-versus-generic-models",
          "definition": "Rented by the token; knows the world.",
          "term": "generic"
        },
        {
          "anchor": "mse435-u04-c04-custom-versus-generic-models",
          "definition": "Tuned on the firm's data; knows the firm; fixed floor plus cheaper tokens.",
