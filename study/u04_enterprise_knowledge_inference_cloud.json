      "keyTerms": [
        {
          "anchor": "mse435-u04-c05-api-versus-hosting",
          "definition": "A taxi: pay per ride, no garage.",
          "term": "API"
        },
        {
          "anchor": "mse435-u04-c05-api-versus-hosting",
          "definition": "A car: pay for garage and fuel whether you drive or not.",
          "term": "hosting"
        },
        {
          "anchor": "mse435-u04-c05-api-versus-hosting-p05",
          "definition": "F / (p_a - p_h), in 1M-token units.",
          "term": "Q*"
        }
      ],
      "minutes": 4,
      "recall": [
        {
          "anchor": "mse435-u04-c05-api-versus-hosting-p04",
          "answer": "Q* = F / (p_a - p_h). The taxi wins at low mileage; the car wins at high mileage. The break-even mileage is the fixed garage cost divided by the per-ride premium.",
          "id": "mse435-u04-c05-api-versus-hosting-r1",
          "question": "API or hosting?"
        }
      ],
      "title": "mse435-U04-C05 , API versus hosting"
