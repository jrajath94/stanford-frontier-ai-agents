      "minutes": 4,
      "recall": [
        {
          "anchor": "mse435-u04-c04-custom-versus-generic-models-p04",
          "answer": "Generic cost = p_g x Q / 1M. Custom cost = F + p_c x Q / 1M. Custom wins above the crossover volume where the fixed floor spreads thin enough.",
          "id": "mse435-u04-c04-custom-versus-generic-models-r1",
          "question": "Custom or generic model?"
        }
      ],
      "title": "mse435-U04-C04 , custom versus generic models"
    },
    {
