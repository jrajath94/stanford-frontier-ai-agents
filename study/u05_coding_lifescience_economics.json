      "keyTerms": [
        {
          "anchor": "mse435-u05-c05-science-workflows-p04",
          "definition": "Design, make, test, learn; AI accelerates design and learn.",
          "term": "science workflow"
        },
        {
          "anchor": "mse435-u05-c05-science-workflows-p03",
          "definition": "T_d / k + T_w; AI cuts design by factor k.",
          "term": "speedup"
        },
        {
          "anchor": "mse435-u05-c05-science-workflows-p04",
          "definition": "Pipetting, incubation, observation; not accelerated by AI.",
          "term": "physical"
        }
      ],
      "minutes": 4,
      "recall": [
        {
          "anchor": "mse435-u05-c05-science-workflows-p04",
          "answer": "T = T_d + T_w. AI cuts design by factor k: T' = T_d/k + T_w. Speedup = T/T'. The physical steps bound the speedup no matter how fast design gets.",
          "id": "mse435-u05-c05-science-workflows-r1",
          "question": "How much does AI speed up science?"
        }
      ],
      "title": "mse435-U05-C05 , science workflows"
